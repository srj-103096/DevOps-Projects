pipeline {
    agent any

    tools {
        jdk 'jdk17'
        maven 'maven3'
    }

    stages {

        stage('Git Checkout') {
            steps {
                git branch: 'master',
                    credentialsId: 'git-cred',
                    url: 'https://github.com/srj-103096/DevOps-Projects.git'
            }
        }

        stage('Compile') {
            steps {
                dir('DevOps-Project-38/FullStack-Blogging-App') {
                    sh '''
                        echo "===== Maven Version ====="
                        mvn -version

                        echo "===== Java Version ====="
                        java -version

                        echo "===== Compile ====="
                        mvn compile
                    '''
                }
            }
        }

        stage('Test') {
            steps {
                dir('DevOps-Project-38/FullStack-Blogging-App') {
                    sh 'mvn test'
                }
            }
        }

        stage('File System Scan') {
            steps {
                dir('DevOps-Project-38/FullStack-Blogging-App') {
                    sh '''
                        set -e

                        mvn dependency:resolve

                        trivy fs \
                            --format table \
                            -o trivy-fs-report.html \
                            .
                    '''
                }
            }
        }

        stage('Build') {
            steps {
                dir('DevOps-Project-38/FullStack-Blogging-App') {
                    sh 'mvn package -DskipTests'
                }
            }
        }

        /*
         * NEXUS REMOVED
         *
         * Publish To Nexus stage has been removed.
         */

        /*
         * SONARQUBE REMOVED
         *
         * SonarQube Analysis stage has been removed.
         * Quality Gate stage has been removed.
         */

        stage('Build & Tag Docker Image') {
            steps {
                dir('DevOps-Project-38/FullStack-Blogging-App') {
                    sh '''
                        set -e

                        /usr/bin/docker build \
                            -t suraj103096/bloggingapp:latest \
                            .

                        echo "===== Docker Image ====="

                        /usr/bin/docker images | grep bloggingapp
                    '''
                }
            }
        }

        stage('Docker Image Scan') {
            steps {
                dir('DevOps-Project-38/FullStack-Blogging-App') {
                    sh '''
                        set -e

                        export TMPDIR=/data/trivy/tmp

                        echo "===== Trivy Storage ====="
                        df -h /data/trivy

                        echo "===== Docker Image Scan ====="

                        trivy \
                            --cache-dir /data/trivy/cache \
                            image \
                            --scanners vuln \
                            --format table \
                            -o trivy-image-report.html \
                            suraj103096/bloggingapp:latest
                    '''
                }
            }
        }

        stage('Push Docker Image') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'docker-cred',
                        usernameVariable: 'DOCKER_USERNAME',
                        passwordVariable: 'DOCKER_PASSWORD'
                    )
                ]) {
                    sh '''
                        set -e

                        echo "$DOCKER_PASSWORD" | /usr/bin/docker login \
                            --username "$DOCKER_USERNAME" \
                            --password-stdin

                        /usr/bin/docker push \
                            suraj103096/bloggingapp:latest

                        /usr/bin/docker logout
                    '''
                }
            }
        }
stage('Deploy To Kubernetes') {
    steps {
        withKubeConfig(
            caCertificate: '',
            clusterName: 'abrahimcse-cluster',
            contextName: '',
            credentialsId: 'k8-cred',
            namespace: 'webapps',
            restrictKubeConfigAccess: false,
            serverUrl: 'https://1E4D1C79D402B9DE3521691F94079A72.yl4.eu-north-1.eks.amazonaws.com'
        ) {
            sh '''
                set -e

                echo "===== Deploying to Kubernetes ====="

                kubectl apply -f deployment-service.yaml
            '''
                }
            }
        }

        stage('Verify the Deployment') {
            steps {
                withKubeConfig(
                    caCertificate: '',
                    clusterName: 'abrahimcse-cluster',
                    contextName: '',
                    credentialsId: 'k8-cred',
                    namespace: 'webapps',
                    restrictKubeConfigAccess: false,
                    serverUrl: 'YOUR_REAL_EKS_ENDPOINT'
                ) {
                    sh '''
                        set -e

                        echo "===== Pods ====="
                        kubectl get pods -n webapps

                        echo "===== Services ====="
                        kubectl get svc -n webapps

                        echo "===== Deployment ====="
                        kubectl get deployment -n webapps
                    '''
                }
            }
        }
    }

    post {
        always {
            script {
                def jobName = env.JOB_NAME
                def buildNumber = env.BUILD_NUMBER
                def pipelineStatus = currentBuild.result ?: 'UNKNOWN'
                def bannerColor = pipelineStatus.toUpperCase() == 'SUCCESS' ? 'green' : 'red'

                def body = """
                    <html>
                    <body>
                    <div style="border: 4px solid ${bannerColor}; padding: 10px;">
                    <h2>${jobName} - Build ${buildNumber}</h2>

                    <div style="background-color: ${bannerColor}; padding: 10px;">
                        <h3 style="color: white;">
                            Pipeline Status: ${pipelineStatus.toUpperCase()}
                        </h3>
                    </div>

                    <p>
                        Check the
                        <a href="${BUILD_URL}">console output</a>.
                    </p>

                    </div>
                    </body>
                    </html>
                """

                emailext(
                    subject: "${jobName} - Build ${buildNumber} - ${pipelineStatus.toUpperCase()}",
                    body: body,
                    to: 'abrahim.ctech@gmail.com',
                    from: 'jenkins@example.com',
                    replyTo: 'jenkins@example.com',
                    mimeType: 'text/html',
                    attachmentsPattern: 'trivy-image-report.html'
                )
            }
        }
    }
}

